{
  "name": "lclc-facilities-dashboard",
  "homepage": "https://isthelclcpoolopen.ca",
  "version": "1.2.0",
  "private": false,
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.16.0",
    "react-scripts": "5.0.1",
    "yaml": "^2.8.3"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "lint": "eslint src/**/*.{js,jsx}"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "rules": {
      "no-restricted-syntax": [
        "error",
        {
          "selector": "NewExpression[callee.name='Date'][arguments.length=0]",
          "message": "Use facilityNow() from src/utils/timezone.js. Schedule data is Halifax wall-clock time, so a viewer-local now breaks every comparison against it."
        }
      ]
    },
    "overrides": [
      {
        "files": [
          "src/utils/timezone.js"
        ],
        "rules": {
          "no-restricted-syntax": "off"
        }
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "autoprefixer": "^10.4.14",
    "eslint": "^8.45.0",
    "postcss": "^8.4.27",
    "tailwindcss": "^3.3.3",
    "typescript": "^4.9.5"
  }
}
